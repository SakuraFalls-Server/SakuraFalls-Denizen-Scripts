chat_data_abbreviations:
    debug: false
    type: data
    # keep all abbreviations lowercase, the code handles uppercase
    abbreviations:
        ttyl: talk to you later
        brb: be right back
        idk: i don't know
        idc: i don't care
        imo: in my opinion
        imho: in my humble opinion
        irl: in real life
        jk: just kidding
        lmk: let me know
        lol: laughing out loud
        omg: oh my god
        omw: on my way
        rn: right now
        smh: shaking my head
        tbh: to be honest
        tho: though
        thx: thanks
        ty: thank you
        np: no problem
        wbu: what about you
        hru: how are you
        wyd: what are you doing
        wya: where you at
        gtg: got to go
        g2g: got to go
        cya: see ya
        btw: by the way
        fyi: for your information
        asap: as soon as possible
        afk: away from keyboard
        ngl: not gonna lie
        tbf: to be fair
        ig: i guess
        nvm: never mind
        pls: please
        plz: please
        cuz: because
        bc: because
        u: you
        ur: your
        r: are
        k: okay
        ok: okay
        yw: you're welcome
        gn: good night
        gm: good morning
